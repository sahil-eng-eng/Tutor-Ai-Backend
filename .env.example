# ============================================
# AI Tutor Platform - Environment Configuration
# ============================================

# Application
APP_NAME=AI_Tutor_Platform
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALLOWED_HOSTS=["*"]

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ai_tutor_db
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_CHEAP_MODEL=gpt-4o-mini
OPENAI_PREMIUM_MODEL=gpt-4o

# ElevenLabs
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1

# Session Configuration
MAX_SESSION_DURATION_MINUTES=180
DEFAULT_SESSION_DURATION_MINUTES=60
MAX_SEGMENTS_PER_SESSION=20

# Pulse Rate Configuration
PULSE_LOW_THRESHOLD=25
PULSE_CHECK_INTERVAL_MINUTES=10

# File Upload
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=uploads

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Nano-Banana Image Generation (callback-based API)
NANOBANANA_API_URL=https://api.nanobananaapi.ai/api/v1/nanobanana/generate
NANOBANANA_API_KEY=your-nano-banana-api-key-here
NANOBANANA_TIMEOUT_SECONDS=60
NANOBANANA_CALLBACK_BASE_URL=https://your-ngrok-url.ngrok-free.dev
NANOBANANA_ENABLED=true

# Email / OTP (placeholder - integrate actual service later)
EMAIL_SERVICE_ENABLED=false
OTP_SERVICE_ENABLED=false
OTP_EXPIRY_MINUTES=10

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
